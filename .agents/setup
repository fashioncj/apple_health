#!/usr/bin/env bash
# Prepare a fresh HealthSync orb: Python backend venv, Next.js deps, and a
# speed-tuned local Postgres. Idempotent; safe to rerun on a warm snapshot.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  local label="$1"
  shift
  local started ended elapsed
  started="$(date +%s)"
  echo "==> ${label}"
  "$@"
  ended="$(date +%s)"
  elapsed="$((ended - started))"
  echo "==> ${label} done in ${elapsed}s"
}

install_packages() {
  local missing=()
  local package
  for package in "$@"; do
    if ! dpkg -s "$package" >/dev/null 2>&1; then
      missing+=("$package")
    fi
  done
  if ((${#missing[@]} == 0)); then
    echo "system packages already installed"
    return 0
  fi
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
}

# Local-only development values. Not production secrets. Written into the
# gitignored .env and used only to create the matching local role.
local_password="healthsync-orb"
local_api_token="healthsync-orb-api-token"
local_hash_secret="healthsync-orb-token-hash-secret"

write_env() {
  if [[ -f .env ]]; then
    echo ".env already exists; leaving it"
    return 0
  fi
  cat > .env <<EOF
# Generated by .agents/setup for local orb development. Not a production secret.
POSTGRES_DB=healthsync
POSTGRES_USER=healthsync
POSTGRES_PASSWORD=${local_password}
POSTGRES_HOST_PORT=15432
API_HOST_PORT=8080
API_TOKEN=${local_api_token}
TOKEN_HASH_SECRET=${local_hash_secret}
HOSTED_PUBLIC_BASE_URL=http://127.0.0.1:8080
HOSTED_PROVISIONING_ENABLED=false
DATABASE_URL=postgresql+psycopg://healthsync:${local_password}@127.0.0.1:15432/healthsync
EOF
  chmod 600 .env
  echo "wrote .env from local orb defaults"
}

configure_postgres() {
  local conf="/etc/postgresql/15/main/postgresql.conf"
  local hba="/etc/postgresql/15/main/pg_hba.conf"
  local marker="# healthsync orb: prefer speed over durability"

  if [[ ! -f "$conf" ]]; then
    echo "postgres config missing at ${conf}" >&2
    return 1
  fi

  if ! sudo grep -Fqx "$marker" "$conf"; then
    sudo tee -a "$conf" >/dev/null <<EOF

${marker}
fsync = off
synchronous_commit = off
full_page_writes = off
listen_addresses = '127.0.0.1'
port = 15432
EOF
  fi
  if ! sudo grep -Eq '^[[:space:]]*healthsync\.dbpass[[:space:]]*=' "$conf"; then
    echo "healthsync.dbpass = ''" | sudo tee -a "$conf" >/dev/null
  fi

  # Trust local TCP so agents can use the documented URL without a password prompt.
  if ! sudo grep -Eq '^host[[:space:]]+all[[:space:]]+all[[:space:]]+127\.0\.0\.1/32[[:space:]]+trust' "$hba"; then
    echo "host all all 127.0.0.1/32 trust" | sudo tee -a "$hba" >/dev/null
  fi

  sudo systemctl enable postgresql
  sudo systemctl restart postgresql

  # Password is a Postgres setting, not interpolated into SQL text.
  sudo --preserve-env=PGOPTIONS -u postgres \
    env PGOPTIONS="-c healthsync.dbpass=${local_password}" \
    psql -p 15432 -v ON_ERROR_STOP=1 <<'SQL'
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'healthsync') THEN
    EXECUTE format('CREATE ROLE healthsync LOGIN PASSWORD %L', current_setting('healthsync.dbpass'));
  ELSE
    EXECUTE format('ALTER ROLE healthsync WITH LOGIN PASSWORD %L', current_setting('healthsync.dbpass'));
  END IF;
END
$$;
SELECT 'CREATE DATABASE healthsync OWNER healthsync'
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = 'healthsync')\gexec
GRANT ALL PRIVILEGES ON DATABASE healthsync TO healthsync;
SQL
  sudo -u postgres psql -p 15432 -d healthsync -v ON_ERROR_STOP=1 \
    -c "GRANT ALL ON SCHEMA public TO healthsync;"
}

install_python() {
  if [[ ! -d .venv ]]; then
    python3 -m venv .venv
  fi
  # shellcheck disable=SC1091
  source .venv/bin/activate
  python -m pip install --upgrade pip
  python -m pip install -r backend/requirements.txt -r backend_stub/requirements.txt
  # 20260605_0004 grants to Supabase roles (anon, authenticated, service_role)
  # that a plain local cluster does not have. Later revisions depend on it, so
  # local orbs stop at the last revision that applies to stock Postgres.
  DATABASE_URL="postgresql+psycopg://healthsync:${local_password}@127.0.0.1:15432/healthsync" \
    .venv/bin/alembic upgrade 20260531_0003
}

install_web() {
  local stamp="web/node_modules/.healthsync-lock-stamp"
  if [[ -d web/node_modules && -f "$stamp" ]] && cmp -s web/package-lock.json "$stamp"; then
    echo "web dependencies match package-lock.json"
    return 0
  fi
  if [[ -f web/package-lock.json ]]; then
    npm ci --prefix web --no-audit --no-fund
    cp -- web/package-lock.json "$stamp"
  else
    npm install --prefix web --no-audit --no-fund
  fi
}

step "install system packages" install_packages python3-venv python3-pip postgresql postgresql-client
step "write local env" write_env
step "configure postgres" configure_postgres
step "install python dependencies" install_python
step "install web dependencies" install_web

guidance="${HOME}/.config/amp/AGENTS.md"
marker="# HealthSync orb notes"
mkdir -p "$(dirname "$guidance")"
if ! grep -Fqx "$marker" "$guidance" 2>/dev/null; then
  cat >> "$guidance" <<'EOF'

# HealthSync orb notes
- Python backend deps live in the repo-root `.venv`. Activate with `source .venv/bin/activate`, or call `.venv/bin/pytest` and `.venv/bin/alembic` directly.
- Backend tests use SQLite and do not need Postgres: `.venv/bin/python -m pytest Tests/backend/test_backend_api.py -q`
- Local Postgres listens on 127.0.0.1:15432 (user/db `healthsync`, password `healthsync-orb`). `.env` holds matching `DATABASE_URL`, `API_TOKEN`, and `TOKEN_HASH_SECRET` for local development only.
- Local Alembic stops at `20260531_0003`. Revision `20260605_0004` requires Supabase roles and fails on this plain Postgres. Use a Supabase `DATABASE_URL` before running `alembic upgrade head`.
- The Next.js site is installed under `web/`. Start it with `amp orb services ensure` (declared in `.amp/services.yaml`), not from setup.
- iOS builds need Xcode and do not run on Linux orbs. `xcodebuild` is unavailable here.
- Docker is installed but the daemon is not running. Prefer the local Postgres above; do not start dockerd from setup.
EOF
fi

echo "HealthSync orb setup complete"
